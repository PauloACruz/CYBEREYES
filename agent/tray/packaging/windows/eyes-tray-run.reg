Windows Registry Editor Version 5.00

; Inicia o EYES na bandeja em toda sessao de usuario (todas as contas da maquina).
; Ajuste o caminho se o executavel for instalado em outra pasta.
[HKEY_LOCAL_MACHINE\SOFTWARE\Microsoft\Windows\CurrentVersion\Run]
"EyesTray"="\"C:\\Program Files\\Cybereyes\\EYES\\eyes-tray.exe\" --hidden"
