# Copie para .env e preencha. Nunca versione o arquivo .env.
CYBEREYES_HOST=rmm.suaempresa.com.br
ACME_EMAIL=ti@suaempresa.com.br

POSTGRES_PASSWORD=troque-por-uma-senha-forte
# Senha do Redis (backplane do SignalR). Use so letras e numeros: ela entra na string de conexao da API.
# Gere com: openssl rand -hex 32
REDIS_PASSWORD=troque-por-uma-senha-forte
NATS_API_USER=cybereyes-api
NATS_API_PASSWORD=troque-por-uma-senha-forte

ADMIN_USERNAME=admin
ADMIN_PASSWORD=troque-por-uma-senha-forte-com-12-ou-mais
ADMIN_EMAIL=ti@suaempresa.com.br

# Chave do cofre de credenciais da documentacao (AES-256, 32 bytes em base64).
# Gere com: openssl rand -base64 32
# Guarde uma copia fora do servidor: sem ela as senhas do cofre nao podem ser recuperadas.
VAULT_KEY=

# Quantidade de instancias da API atras do balanceador Nginx
API_REPLICAS=2

REGISTRY=ghcr.io/pauloacruz
VERSION=latest
# Versao do EYES distribuida pela API. Vazio (recomendado): a versao compilada na imagem da API (agent/VERSION).
# Binarios em infra/docker/agents (eyes-v<versao>-<plat>-<arch>[.exe]) tem prioridade sobre os embutidos.
AGENT_VERSION=

# Para emitir certificados Let's Encrypt automaticamente, suba com:
#   docker compose --profile letsencrypt up -d
# Para usar certificado proprio, coloque fullchain.pem e privkey.pem em certs/<host>/
COMPOSE_PROFILES=letsencrypt

# Backup diario (servico "backup"; ver docs/runbooks/backup-restauracao.md)
# Horario HH:MM no fuso TZ, dias de retencao e pasta no servidor onde os conjuntos ficam.
TZ=America/Sao_Paulo
BACKUP_TIME=02:30
BACKUP_KEEP_DAYS=14
BACKUP_HOST_DIR=./backups
# Se preenchida, cifra os arquivos (openssl aes-256-cbc + pbkdf2). Guarde-a fora do servidor.
# Gere com: openssl rand -base64 32
BACKUP_PASSPHRASE=
# true copia o .env para o backup (so funciona com BACKUP_PASSPHRASE, porque o .env tem a VAULT_KEY)
BACKUP_INCLUDE_ENV=false
