# Copie para .env e preencha. Nunca versione o arquivo .env.
WINCARE_HOST=rmm.suaempresa.com.br
MESH_HOST=mesh.suaempresa.com.br
ACME_EMAIL=ti@suaempresa.com.br

POSTGRES_PASSWORD=troque-por-uma-senha-forte
NATS_API_USER=wincare-api
NATS_API_PASSWORD=troque-por-uma-senha-forte

ADMIN_USERNAME=admin
ADMIN_PASSWORD=troque-por-uma-senha-forte-com-12-ou-mais
ADMIN_EMAIL=ti@suaempresa.com.br

# Chave do cofre de credenciais da documentacao (AES-256, 32 bytes em base64).
# Gere com: openssl rand -base64 32
# Guarde uma copia fora do servidor: sem ela as senhas do cofre nao podem ser recuperadas.
VAULT_KEY=

# Quantidade de instancias da API atras do balanceador Nginx
API_REPLICAS=2

REGISTRY=ghcr.io/pauloacruz
VERSION=latest
MESHCENTRAL_VERSION=1.2.5
# Usuario administrador interno do MeshCentral usado pela API e nome do grupo de dispositivos
MESH_USER=wincare
MESH_DEVICE_GROUP=WinCare

# Para emitir certificados Let's Encrypt automaticamente, suba com:
#   docker compose --profile letsencrypt up -d
# Para usar certificado proprio, coloque fullchain.pem e privkey.pem em certs/<host>/
COMPOSE_PROFILES=letsencrypt
